 .../components/UI/Sidebar/components/HeroicVersion/index.tsx   | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)
 create mode 100644 src/common/downstreamVersion.ts

diff --git a/src/common/downstreamVersion.ts b/src/common/downstreamVersion.ts
new file mode 100644
index 00000000..7e25f821
--- /dev/null
+++ b/src/common/downstreamVersion.ts
@@ -0,0 +1,2 @@
+// Reconstruction stamps upstream version and accepted queue length before builds.
+export const downstreamVersion: string | undefined = undefined
diff --git a/src/frontend/components/UI/Sidebar/components/HeroicVersion/index.tsx b/src/frontend/components/UI/Sidebar/components/HeroicVersion/index.tsx
index 5e245763..d68fe0ec 100644
--- a/src/frontend/components/UI/Sidebar/components/HeroicVersion/index.tsx
+++ b/src/frontend/components/UI/Sidebar/components/HeroicVersion/index.tsx
@@ -5,6 +5,7 @@ import { ChangelogModal } from '../../../ChangelogModal'
